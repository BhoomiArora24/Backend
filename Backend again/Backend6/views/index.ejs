<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
</head>
<body>
    <div class="main w-full min-h-screen bg-zinc-900">
        <div class="form p-10">
            <form action="">
                <input class='w-full rounded-md outline-none text-white block px-5 py-2 bg-zinc-800'type="text" placeholder="Title goes here"/>
                <textarea class='w-full rounded-md outline-none text-white block mt-2 px-5 py-2 bg-zinc-800 resize-none'type="text" placeholder="Write your text here"></textarea>
                <input class='mt-2 bg-blue-600 px-5 py-2 rounded-md text-white' type="submit" value="create task"
            </form>
        </div>
        <div class="tasks flex gap-3 flex-wrap p-10">
            <% files.forEach(function(val))%>
            <div class="task hidden w-72 px-3 py-4 bg-zinc-800 rounde-md">
                <h1 class="text-white text-3xl tracking-lighter">Some tasks goes here</h1>
                <a class="text-blue-500 inline-block mt-3" href="">Read more</a>
            </div>
            <div class="task hidden w-72 px-3 py-4 bg-zinc-800 rounde-md">
                <h1 class="text-white text-3xl tracking-lighter">Some tasks goes here</h1>
                <a class="text-blue-500 inline-block mt-3" href="">Read more</a>
            </div>
            <div class="task hidden w-72 px-3 py-4 bg-zinc-800 rounde-md">
                <h1 class="text-white text-3xl tracking-lighter">Some tasks goes here</h1>
                <a class="text-blue-500 inline-block mt-3" href="">Read more</a>
            </div>
            <h3 class="text-zinc-600">No task yet</h3>
        </div>
    </div>
</body>
</html>